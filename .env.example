# ==============================================================================
# KENZAE BOUTIQUE DIGITAL CATALOG — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD DATABASE & REALTIME
# ------------------------------------------------------------------------------
# Frontend Client Keys (Vite exposed):
# Modern Supabase uses Publishable Key (sb_publish_...) or legacy Anon Key (eyJhb...)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publish_...
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi... (Legacy fallback)

# Server-Side Admin Key (Used in API routes / Serverless functions):
# Modern Supabase uses Secret Key (sb_secret_...) or legacy Service Role Key (eyJhb...)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (Legacy fallback)
SUPABASE_STORAGE_BUCKET=kenzae-catalog-images

# ------------------------------------------------------------------------------
# 2. S3-COMPATIBLE IMAGE STORAGE PIPELINE (AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# If using AWS S3 or Cloudflare R2 instead of Supabase Storage:
AWS_S3_BUCKET=kenzae-catalog-media
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Custom endpoint for Cloudflare R2 or MinIO
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Optional: Custom CDN domain
# VITE_CDN_URL=https://cdn.kenzae.com

# ------------------------------------------------------------------------------
# 3. SECURE SERVER AUTH FOR BOUTIQUE STAFF PORTAL (/staff)
# ------------------------------------------------------------------------------
# Boutique staff master passcode (kept server-side, never bundled in client JS):
STAFF_PASSCODE=kenzae2026
# Cryptographic secret for signing staff session JWTs:
STAFF_JWT_SECRET=kenzae-boutique-mulanthuruthy-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 4. GEMINI AI HIGH-FASHION MODEL DRAPE GENERATION (api/generate-drape)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
